# --- Server -----------------------------------------------------------------
PORT=3000
# Address to listen on. The default (127.0.0.1) accepts this machine only. Set HOST=0.0.0.0 only
# behind an HTTPS reverse proxy, and never together with DEV_OFFLINE.
# HOST=127.0.0.1
# Public URL of this site (used for the OAuth redirect URI: <PUBLIC_URL>/auth/callback)
PUBLIC_URL=http://localhost:3000

# --- Microsoft sign-in (required for playing) --------------------------------
# Azure "App registrations" -> Application (client) ID. See README.
AZURE_CLIENT_ID=
# Only needed when the redirect URI is registered under the "Web" platform.
AZURE_CLIENT_SECRET=
# Minecraft accounts are personal Microsoft accounts.
AZURE_TENANT=consumers

# --- Optional -----------------------------------------------------------------
# Encrypts the server-side session store. Generated into data/ when empty.
SESSION_SECRET=
# CheerpJ runtime version and (for commercial use) license key.
CHEERPJ_VERSION=4.3
CHEERPJ_LICENSE_KEY=
# Development only: lets THIS machine (localhost) start the game without signing in. You still
# need to own Minecraft: Java Edition. Ignored unless HOST is a loopback address. Keep it 0.
# Never enable it on a server other people can reach.
DEV_OFFLINE=0
